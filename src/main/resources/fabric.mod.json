{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["jasonxue"],
  "contact": {
    "homepage": "${website}",
    "issues": "${issues}",
    "sources": "${source}"
  },
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["com.sguserver.remotebotfetch.Mod"],
    "preLaunch": ["com.sguserver.remotebotfetch.PreLaunch"]
  },
  "mixins": ["remote-bot-fetch-server.mixins.json"],
  "accessWidener": "remote-bot-fetch-server.accesswidener",
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_dependency}",
    "carpet": "*"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"],
      "parent": "remote-bot-fetch",
      "links": {
        "modmenu.website": "${website}",
        "modmenu.github_releases": "${source}/releases",
        "modmenu.issues": "${issues}"
      },
      "update_checker": false
    }
  }
}
